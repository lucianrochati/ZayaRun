# Copie para .env e preencha. NUNCA comite o .env de verdade.

# Django
SECRET_KEY=troque-por-uma-chave-secreta-longa
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco (local usa sqlite por padrao se nao definir).
# No Heroku, DATABASE_URL e definido automaticamente.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Strava API (crie em https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# URL de callback registrada no painel da Strava.
# Local: http://127.0.0.1:8000/strava/callback/
STRAVA_REDIRECT_URI=http://127.0.0.1:8000/strava/callback/

# IA do Copiloto / Insight / prescricao (opcional — sem chave cai p/ regras).
# AI_PROVIDER: auto (usa a chave que existir, priorizando a GRATUITA Gemini),
#              gemini, claude ou rules (desliga a IA).
AI_PROVIDER=auto
# Gemini = GRATIS (crie em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Claude (pago) — alternativa: https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# INSIGHT_MODEL=claude-opus-4-8
